{
  "app-id": "de.wagnermartin.Plattenalbum",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "plattenalbum",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-run/mpd:ro",
    "--filesystem=/run/mpd:ro"
  ],
  "modules": [
    {
      "name": "plattenalbum",
      "sources": [{
        "type": "git",
        "url": "https://github.com/SoongNoonien/plattenalbum.git",
        "tag": "v2.6.0",
        "commit": "d914c63239eb0016f1ad5e59ca4261a3c948aae0"
      }],
      "builddir" : true,
      "buildsystem": "meson"
    }
  ]
}
