{
  "app-id": "de.wagnermartin.Plattenalbum",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "plattenalbum",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-run/mpd:ro",
    "--filesystem=/run/mpd:ro"
  ],
  "modules": [
    {
      "name": "plattenalbum",
      "sources": [{
        "type": "git",
        "url": "https://github.com/SoongNoonien/plattenalbum.git",
        "tag": "v2.8.0",
        "commit": "d3f2fc7e943870b1e7156271ad5a6980a2f750a1"
      }],
      "builddir" : true,
      "buildsystem": "meson"
    }
  ]
}
